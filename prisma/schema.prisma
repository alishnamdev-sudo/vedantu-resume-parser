generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Programme {
  PHONICS
  SUPER_SPEAKERS
  SUPER_CODERS
  SUPER_MATH
}

enum Verdict {
  GTG
  ON_HOLD
  NOT_CONSIDERED
}

enum Source {
  FORM
  BULK_CSV
}

model Candidate {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  subject        String?
  programme      Programme
  source         Source    @default(FORM)
  uploadedBy     String?

  resumeFileName String
  resumeFilePath String
  resumeMimeType String
  resumeText     String
  resumeSourceUrl String?

  verdict        Verdict?
  reason         String?
  matchedProfile String?
  fastTrack      Boolean   @default(false)
  flags          String?
  rawAnalysis    String?
  analysisError  String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  analysisRuns   AnalysisRun[]
}

enum AnalysisTrigger {
  FORM
  BULK_CSV
  RETRY
  REANALYZE
}

enum AnalysisStatus {
  OK
  INVALID_JSON
  SCHEMA_MISMATCH
  API_ERROR
}

/// One row per Gemini attempt (retries included, since they're billed too).
model AnalysisRun {
  id                String          @id @default(cuid())
  // SetNull keeps cost history when a candidate is deleted.
  candidate         Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  candidateId       String?
  trigger           AnalysisTrigger
  model             String
  promptVersion     String
  attempt           Int
  status            AnalysisStatus
  errorMessage      String?
  latencyMs         Int
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  thinkingTokens    Int?
  costUsd           Decimal?        @db.Decimal(10, 6)
  verdict           Verdict?
  fastTrack         Boolean?
  createdAt         DateTime        @default(now())

  @@index([createdAt])
  @@index([candidateId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
